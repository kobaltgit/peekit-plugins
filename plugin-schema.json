{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PeekIt Plugin Manifest Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "author",
    "description",
    "extensions",
    "entry",
    "min_peekit_version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "Уникальный идентификатор плагина в стиле обратного домена (например: com.peekit.font-viewer)"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Человекочитаемое название плагина"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Семантическая версия (SemVer 2.0)"
    },
    "author": {
      "type": "string",
      "description": "Имя или никнейм автора/организации"
    },
    "description": {
      "type": "string",
      "maxLength": 300,
      "description": "Краткое описание назначения и возможностей плагина"
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^\\.[a-zA-Z0-9_-]+$"
      },
      "description": "Список расширений файлов, обрабатываемых плагином (начиная с точки, например ['.stl', '.obj'])"
    },
    "entry": {
      "type": "string",
      "default": "index.html",
      "description": "Входная HTML-точка плагина"
    },
    "min_peekit_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Минимальная требуемая версия PeekIt"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read_file",
          "clipboard_write"
        ]
      },
      "description": "Запрашиваемые привилегии"
    },
    "icon": {
      "type": "string",
      "description": "Путь к файлу иконки внутри директории плагина (SVG или PNG)"
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Ссылка на репозиторий или сайт плагина"
    },
    "default_dimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 2160
        }
      },
      "description": "Рекомендуемые начальные размеры окна"
    }
  },
  "additionalProperties": false
}