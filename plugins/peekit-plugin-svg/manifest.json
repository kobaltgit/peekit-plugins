{
  "$schema": "https://raw.githubusercontent.com/kobaltgit/peekit-plugins/main/plugin-schema.json",
  "id": "com.peekit.svg-studio",
  "name": "SVG Studio & Inspector",
  "version": "1.1.0",
  "author": "Kobalt",
  "description": "Interactive vector studio with DOM tree inspector, color palette recoloring, high-res PNG export, and code generator",
  "extensions": [
    ".svg"
  ],
  "entry": "index.html",
  "min_peekit_version": "1.0.0",
  "permissions": [
    "read_file",
    "save_file",
    "clipboard_write"
  ],
  "icon": "icon.svg",
  "category": "Graphics",
  "homepage": "https://github.com/kobaltgit/peekit-plugins",
  "default_dimensions": {
    "width": 960,
    "height": 680
  },
  "supportedExtensions": [
    ".svg"
  ]
}
