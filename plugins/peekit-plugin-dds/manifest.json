  "extensions": [
    ".dds"
  ],
  "entry": "index.html",
  "min_peekit_version": "1.0.0",
  "category": "Graphics",
  "icon": "icon.svg",
  "homepage": "https://github.com/kobaltgit/peekit-plugins",
  "default_dimensions": {
    "width": 840,
    "height": 600
  },
  "supportedExtensions": [
    ".dds"
  ]
}
