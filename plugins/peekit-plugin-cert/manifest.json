{
  "$schema": "https://raw.githubusercontent.com/kobaltgit/peekit-plugins/main/plugin-schema.json",
  "id": "com.peekit.cert-inspector",
  "name": "Certificate & Security Key Inspector",
  "version": "1.0.0",
  "author": "Kobalt",
  "description": "Fast offline inspector for X.509 SSL/TLS certificates, certificate chains, CSR requests, OpenSSH public keys, and private key metadata",
  "extensions": [
    ".crt",
    ".cer",
    ".pem",
    ".der",
    ".pub",
    ".key",
    ".csr"
  ],
  "entry": "index.html",
  "min_peekit_version": "1.0.0",
  "permissions": [
    "read_file",
    "clipboard_write"
  ],
  "icon": "icon.svg",
  "category": "Utilities",
  "homepage": "https://github.com/kobaltgit/peekit-plugins",
  "default_dimensions": {
    "width": 860,
    "height": 620
  }
}
